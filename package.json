{
  "name": "goodreads-mcp-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read your Goodreads library from MCP clients without sharing your Goodreads password.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "pnpm check && pnpm build && node scripts/publish-packages.mjs",
    "release:verify": "pnpm check && pnpm build && RELEASE_DRY_RUN=1 node scripts/publish-packages.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.13",
    "@better-auth/core": "1.7.13",
    "@better-auth/mcp": "^1.7.13",
    "@better-auth/oauth-provider": "^1.7.13",
    "@better-auth/utils": "0.5.1",
    "@better-fetch/fetch": "1.3.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "better-auth": "^1.7.13",
    "better-call": "1.4.4",
    "mcp-handler": "2.1.1",
    "zod": "4.6.4"
  }
}

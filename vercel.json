{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "functions": {
    "api/server.ts": {
      "maxDuration": 60
    },
    "api/oauth-mcp.ts": {
      "maxDuration": 60
    },
    "api/cron/purge-unused.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/purge-unused",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://goodreads-mcp-chi.vercel.app"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://goodreads-mcp-chi.vercel.app"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-authorization-server/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    },
    {
      "source": "/api/oauth-authorization-server",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/server"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/oauth/mcp",
      "destination": "/api/oauth-mcp"
    },
    {
      "source": "/sign-in",
      "destination": "/api/sign-in"
    },
    {
      "source": "/connect",
      "destination": "/api/connect"
    },
    {
      "source": "/consent",
      "destination": "/api/consent"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/oauth/mcp",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/api/auth",
      "destination": "/api/oauth-authorization-server"
    },
    {
      "source": "/api/auth/:authPath*",
      "destination": "/api/auth/[...all]"
    }
  ]
}

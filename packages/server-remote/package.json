{
  "name": "@goodreads-mcp/server-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pretypecheck": "pnpm --filter @organized-chaos/goodreads-mcp-core build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply goodreads-mcp --local",
    "db:migrate": "wrangler d1 migrations apply goodreads-mcp --remote"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.0",
    "@organized-chaos/goodreads-mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.1",
    "agents": "^0.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "4.141.0"
  }
}

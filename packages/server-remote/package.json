{
  "name": "@goodreads-mcp/server-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pretypecheck": "pnpm --filter @organized-chaos/goodreads-mcp-core build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply goodreads-mcp --local",
    "db:migrate": "wrangler d1 migrations apply goodreads-mcp --remote"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.2",
    "@organized-chaos/goodreads-mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "^0.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260728.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  }
}

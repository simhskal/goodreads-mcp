{
  "name": "@organized-chaos/goodreads-mcp",
  "version": "0.2.0",
  "description": "Turn your Goodreads history into private context for Claude and Codex.",
  "type": "module",
  "bin": {
    "goodreads-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "pretypecheck": "pnpm --filter @organized-chaos/goodreads-mcp-core build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@organized-chaos/goodreads-mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright-core": "1.65.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simhskal/goodreads-mcp.git"
  },
  "keywords": [
    "goodreads",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "reading-history",
    "book-recommendations",
    "reading-tracker",
    "private-by-default"
  ]
}

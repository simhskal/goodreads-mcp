{
  "name": "goodreads-mcp",
  "version": "0.1.1",
  "description": "A local Goodreads library MCP server",
  "type": "module",
  "bin": {
    "goodreads-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "pretypecheck": "pnpm --filter @organized-chaos/goodreads-mcp-core build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@organized-chaos/goodreads-mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright-core": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "goodreads",
    "mcp",
    "model-context-protocol"
  ]
}
